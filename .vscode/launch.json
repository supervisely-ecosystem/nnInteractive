{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Test",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/supervisely_integration/test/main.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}:${PYTHONPATH}"
      }
    },
    {
      "name": "Run Uvicorn",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "src.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
        "--ws",
        "websockets"
      ],
      "jinja": true,
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}:${PYTHONPATH}",
        "LOG_LEVEL": "DEBUG"
      }
    },
    {
            "name": "Advanced mode for Supervisely Team",
            "type": "python",
            "cwd": "${workspaceFolder}",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "src.main:app",
                "--host",
                "0.0.0.0",
                "--port",
                "8000",
                "--ws",
                "websockets",
                "--app-dir",
				"supervisely_integration/serve"
            ],
            "jinja": true,
            "justMyCode": false,
            "env": {
				"PYTHONPATH": "${workspaceFolder}:${PYTHONPATH}",
				"LOG_LEVEL": "DEBUG",
				"DEBUG_APP_DIR": "app_data",
				"DEBUG_WITH_SLY_NET": "1",
				"APP_NAME": "nnInteractive",
				"TEAM_ID": "8"
			}
        }
  ]
}
